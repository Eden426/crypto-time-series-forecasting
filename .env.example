# Hugging Face Hub repository ID where GRU models & scalers are hosted
# Example: your-hf-username/crypto-time-series-gru
# Leave empty in local development to load from local ./models directory
HF_REPO_ID=

# Optional: Hugging Face Read Token (only required if your HF model repo is private)
HF_TOKEN=

# Comma-separated list of allowed frontend origins for CORS (or * for all)
# Example: https://crypto-time-series-forecasting.vercel.app
ALLOWED_ORIGINS=*

# Server port (automatically injected by Render in production)
PORT=8000
